# 多模型智能编排网关环境配置示例
# 复制此文件为 .env 并修改相应配置

# ── 基础服务配置 ────────────────────────────────────────────────────────────
APP_NAME=模枢 ModelHub
APP_VERSION=1.0.0
# 前端构建产物目录（Vite build 输出；本地开发无需构建，由 Vite dev server 代理）
FRONTEND_DIST=frontend/dist
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ── 数据库配置 ────────────────────────────────────────────────────────────────
# 开发环境使用 SQLite
DATABASE_URL=sqlite+aiosqlite:///./gateway.db
# 生产环境使用 PostgreSQL
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ── 缓存配置 ────────────────────────────────────────────────────────────────
# Redis URL（可选，留空则使用内存缓存）
# REDIS_URL=redis://localhost:6379/0

# ── 安全配置 ────────────────────────────────────────────────────────────────
# JWT 签名密钥（生产环境必须修改为随机长字符串）
SECRET_KEY=change-me-in-production-use-a-long-random-string-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 供应商凭证加密密钥（32字节 base64，生产环境必须修改）
# 生成方法: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
CREDENTIALS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ── 上游供应商 API Key ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
GEMINI_API_KEY=xxx

# ── 限流配置 ────────────────────────────────────────────────────────────────
RATE_LIMIT_RPM=300
RATE_LIMIT_GLOBAL_RPM=10000

# ── 计费配置 ────────────────────────────────────────────────────────────────
# 新用户注册赠送额度（美元），商用可设为 0
SIGNUP_BONUS_USD=10

# ── 路由配置 ────────────────────────────────────────────────────────────────
MAX_RETRIES=2
UPSTREAM_TIMEOUT_SECONDS=30.0

# ── 健康检查配置 ───────────────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL_SECONDS=30
CIRCUIT_BREAKER_THRESHOLD=0.5
CIRCUIT_BREAKER_WINDOW_SECONDS=60
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# ── CORS 配置 ────────────────────────────────────────────────────────────────
# 允许的跨域来源，生产环境应设置具体域名
CORS_ORIGINS=["*"]

# ── 日志配置 ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
